---
const services = [
  {
    number: "01",
    title: "Frontend Development",
    description:
      "Building responsive and interactive interfaces using modern web technologies.",
    image:
      "https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=900&q=85",
    technologies: ["HTML", "CSS", "JavaScript"],
  },
  {
    number: "02",
    title: "Web Development",
    description: "Creating structured, functional, and user-friendly websites.",
    image:
      "https://images.unsplash.com/photo-1547658719-da2b51169166?auto=format&fit=crop&w=900&q=85",
    technologies: ["Astro", "Tailwind CSS"],
  },
  {
    number: "03",
    title: "Backend Development",
    description:
      "Working with application logic, server-side functionality, and data processing.",
    image:
      "https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=900&q=85",
    technologies: ["PHP", "JavaScript"],
  },
  {
    number: "04",
    title: "Database Management",
    description:
      "Organizing and managing application data through structured database systems.",
    image:
      "https://images.unsplash.com/photo-1544383835-bda2bc66a55d?auto=format&fit=crop&w=900&q=85",
    technologies: ["MySQL", "SQL"],
  },
];

const skills = [
  ["HTML", "Website Structure"],
  ["CSS", "Website Styling"],
  ["JavaScript", "Programming"],
  ["Astro", "Web Framework"],
  ["Tailwind CSS", "Responsive UI"],
  ["PHP", "Backend Programming"],
  ["MySQL", "Database Management"],
  ["Git & GitHub", "Version Control"],
];
---

<section class="section services-section" id="services">
  <div class="container">
    <div class="section-heading">
      <div>
        <span class="eyebrow">02 / WHAT I CAN DO</span>
        <h2>
          MY <span>SKILLS.</span>
          <br />
          YOUR SOLUTIONS.
        </h2>
      </div>
      <p>
        My technical capabilities and programming knowledge help bring digital
        ideas to life.
      </p>
    </div>

    <div class="services-grid">
      {services.map((service) => (
        <article class="service-card">
          <div class="service-image">
            <img src={service.image} alt={service.title} loading="lazy" />
            <span class="service-number">{service.number} / SERVICE</span>
          </div>

          <div class="service-content">
            <div class="service-icon">↗</div>
            <h3>{service.title}</h3>
            <p>{service.description}</p>

            <div class="tag-list">
              {service.technologies.map((technology) => (
                <span>{technology}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="skills-panel">
      <div class="skills-title">
        <span class="eyebrow">MY TECHNICAL TOOLKIT</span>
        <h3>Technologies I Work With.</h3>
        <p>
          Programming languages, frameworks, and tools used throughout my
          development work.
        </p>
      </div>

      <div class="skills-grid">
        {skills.map((skill, index) => (
          <div class="skill-item">
            <span class="skill-index">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div>
              <strong>{skill[0]}</strong>
              <small>{skill[1]}</small>
            </div>
            <span class="skill-arrow">↗</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
