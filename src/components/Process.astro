---
const steps = [
  {
    number: "01",
    title: "Planning",
    description:
      "Understanding project goals, requirements, and functionality.",
    image:
      "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=900&q=85",
  },
  {
    number: "02",
    title: "Designing",
    description:
      "Creating layouts and user interfaces that are clear and easy to use.",
    image:
      "https://images.unsplash.com/photo-1559028006-448665bd7c7f?auto=format&fit=crop&w=900&q=85",
  },
  {
    number: "03",
    title: "Development",
    description: "Writing organized code and implementing website features.",
    image:
      "https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=900&q=85",
  },
  {
    number: "04",
    title: "Testing",
    description:
      "Finding errors, debugging, and improving website functionality.",
    image:
      "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=900&q=85",
  },
  {
    number: "05",
    title: "Deployment",
    description: "Preparing the finished website for launch and maintenance.",
    image:
      "https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=900&q=85",
  },
];
---

<section class="section process-section" id="process">
  <div class="container">
    <div class="section-heading">
      <div>
        <span class="eyebrow">03 / HOW I WORK</span>
        <h2>
          FROM IDEA
          <br />
          TO <span>EXECUTION.</span>
        </h2>
      </div>

      <p>
        Every project follows a structured development process to achieve
        quality, usability, and functionality.
      </p>
    </div>

    <div class="process-grid">
      {steps.map((step) => (
        <article class="process-card">
          <div class="process-image">
            <img src={step.image} alt={step.title} loading="lazy" />
            <span>{step.number}</span>
          </div>

          <div class="process-content">
            <h3>{step.title}</h3>
            <p>{step.description}</p>
            <span class="process-arrow">↗</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
