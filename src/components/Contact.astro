<section class="section contact-section" id="contact">
  <div class="container">
    <span class="eyebrow">06 / LET'S CONNECT</span>

    <h2>
      HAVE AN IDEA?
      <br />
      <span>LET'S BUILD IT.</span>
    </h2>

    <p>
      Interested in my programming work or want to collaborate on a project?
      Let's connect and create something meaningful.
    </p>

    <button
      class="button button-primary contact-button"
      id="contactToggle"
      type="button"
      aria-expanded="false"
      aria-controls="contactDialog"
    >
      LET'S TALK ↗
    </button>

    <dialog
      class="contact-dialog"
      id="contactDialog"
      aria-labelledby="contactDialogTitle"
    >
      <div class="contact-dialog-header">
        <h3 id="contactDialogTitle">LET'S TALK.</h3>
        <button
          class="contact-dialog-close"
          id="contactDialogClose"
          type="button"
          aria-label="Close contact form"
        >
          &times;
        </button>
      </div>

      <form
        class="contact-form"
        id="contactForm"
        action="mailto:your-email@example.com"
        method="post"
        enctype="text/plain"
      >
        <label>
          <span>Name</span>
          <input type="text" name="name" autocomplete="name" required />
        </label>

        <label>
          <span>Email</span>
          <input
            type="email"
            name="email"
            autocomplete="email"
            required
          />
        </label>

        <label class="contact-message">
          <span>Message</span>
          <textarea name="message" rows="5" required></textarea>
        </label>

        <button class="button button-primary contact-submit" type="submit">
          SEND MESSAGE ↗
        </button>
      </form>
    </dialog>

    <div class="contact-bottom">
      <span>STRYDE / DIGITAL DEVELOPMENT</span>
      <span>BUILT WITH CREATIVITY & CODE.</span>
    </div>
  </div>
</section>

<script>
  const contactToggle =
    document.querySelector<HTMLButtonElement>("#contactToggle");
  const contactDialog =
    document.querySelector<HTMLDialogElement>("#contactDialog");
  const contactDialogClose =
    document.querySelector<HTMLButtonElement>("#contactDialogClose");
  const contactForm =
    document.querySelector<HTMLFormElement>("#contactForm");

  const closeContactDialog = () => {
    if (!contactDialog?.open) return;

    contactDialog.close();
    contactToggle?.setAttribute("aria-expanded", "false");
    contactToggle?.focus();
  };

  contactToggle?.addEventListener("click", () => {
    if (!contactDialog || !contactForm) return;

    contactDialog.showModal();
    contactToggle.setAttribute("aria-expanded", "true");
    contactForm.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
  });

  contactDialogClose?.addEventListener("click", () => {
    closeContactDialog();
  });

  contactDialog?.addEventListener("cancel", (event) => {
    event.preventDefault();
    closeContactDialog();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && contactDialog?.open) {
      event.preventDefault();
      closeContactDialog();
    }
  });
</script>
