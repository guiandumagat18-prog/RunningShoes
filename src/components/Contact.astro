<!-- CONTACT SECTION -->
<section id="contact" class="py-32 bg-offwhite border-t border-gray-200">
  <div class="max-w-2xl mx-auto px-6 text-center">
    <span class="text-xs font-bold tracking-[0.3em] uppercase text-gray-400 mb-5 block">
      Get in Touch
    </span>

    <h2 class="text-4xl md:text-5xl font-black mb-6 font-Montserrat text-charcoal uppercase tracking-tight">
      Contact Us
    </h2>

    <p class="text-gray-500 mb-10 font-light leading-relaxed max-w-md mx-auto">
      Have questions about our gear, orders, or run clubs? Send us a message and
      our team will get back to you.
    </p>

    <!-- The Contact Form -->
    <form class="space-y-4 max-w-lg mx-auto text-left">
      <!-- Name Input -->
      <div>
        <label class="sr-only" for="name">
          Full Name
        </label>
        <input
          type="text"
          id="name"
          name="name"
          placeholder="Full Name"
          class="w-full bg-white border border-gray-200 rounded-lg px-6 py-4 text-charcoal placeholder:text-gray-400 focus:outline-none focus:border-charcoal transition-colors"
          required
        />
      </div>

      <!-- Email Input -->
      <div>
        <label class="sr-only" for="email">
          Email Address
        </label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="Email Address"
          class="w-full bg-white border border-gray-200 rounded-lg px-6 py-4 text-charcoal placeholder:text-gray-400 focus:outline-none focus:border-charcoal transition-colors"
          required
        />
      </div>

      <!-- Message Input -->
      <div>
        <label class="sr-only" for="message">
          Message
        </label>
        <textarea
          id="message"
          name="message"
          rows="5"
          placeholder="Your Message"
          class="w-full bg-white border border-gray-200 rounded-lg px-6 py-4 text-charcoal placeholder:text-gray-400 focus:outline-none focus:border-charcoal transition-colors resize-none"
          required
        ></textarea>
      </div>

      <!-- Submit Button -->
      <button
        type="submit"
        class="w-full bg-charcoal text-offwhite px-10 py-4 rounded-lg font-medium hover:bg-volt hover:text-charcoal transition-all duration-300"
      >
        Send Message
      </button>
    </form>
  </div>
</section>

<!-- FOOTER -->
<footer class="bg-white py-12 border-t border-gray-200 text-center text-gray-500 text-sm">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col md:flex-row justify-between items-center gap-8">
      <!-- Brand -->
      <div class="text-center md:text-left">
        <h3 class="text-2xl font-black tracking-tighter font-Montserrat text-charcoal">
          STRYDE<span class="text-gray-400">.</span>
        </h3>
        <p class="text-xs text-gray-400 mt-2">
          Engineered for speed. Designed for the relentless.
        </p>
      </div>

      <!-- Social Links -->
      <div class="flex gap-8 font-medium">
        <a href="#" class="hover:text-charcoal transition-colors">
          Instagram
        </a>
        <a href="#" class="hover:text-charcoal transition-colors">
          Facebook
        </a>
        <a href="#" class="hover:text-charcoal transition-colors">
          TikTok
        </a>
      </div>
    </div>

    <div class="border-t border-gray-100 mt-10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p>© 2026 STRYDE. All rights reserved.</p>
      <p class="text-xs tracking-widest uppercase">Run Your Own Race.</p>
    </div>
  </div>
</footer>
