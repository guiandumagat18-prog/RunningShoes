---
const projects = [
  {
    number: "01",
    title: "STRYDE Website",
    type: "STARTUP WEBSITE",
    description:
      "A shoe startup website developed with responsive layouts, modern web technologies, and interactive components.",
    technologies: ["Astro", "HTML", "CSS", "JavaScript"],
    image: "/Angular%20Black%20Speed%20Emblem.png",
  },
  {
    number: "02",
    title: "Responsive Web Interfaces",
    type: "FRONTEND DEVELOPMENT",
    description:
      "Interface development focused on responsive layouts, reusable components, and user-friendly experiences.",
    technologies: ["HTML", "CSS", "Tailwind CSS"],
    image:
      "https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1000&q=85",
  },
  {
    number: "03",
    title: "Database Applications",
    type: "BACKEND DEVELOPMENT",
    description:
      "Programming practice involving structured data, database relationships, and application logic.",
    technologies: ["PHP", "MySQL", "SQL"],
    image:
      "https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=1000&q=85",
  },
];
---

<section class="section projects-section" id="projects">
  <div class="container">
    <div class="section-heading">
      <div>
        <span class="eyebrow">05 / SELECTED WORK</span>
        <h2>
          PROJECTS IN
          <br />
          <span>DEVELOPMENT.</span>
        </h2>
      </div>

      <p>
        A showcase of my development work, technical implementations, and
        programming experience.
      </p>
    </div>

    <div class="projects-grid">
      {projects.map((project) => (
        <article class="project-card">
          <div class="project-image">
            <img src={project.image} alt={project.title} loading="lazy" />
            <span class="project-count">{project.number}</span>
          </div>

          <div class="project-details">
            <span class="project-type">{project.type}</span>
            <h3>{project.title}</h3>
            <p>{project.description}</p>

            <div class="tag-list">
              {project.technologies.map((technology) => (
                <span>{technology}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
